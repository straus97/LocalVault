<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) rules for apps targeting API 31+. Nothing in the
     app's private storage is ever transferred: not to Google cloud backup,
     and not during device-to-device migration. Private storage holds the
     recent-vault list (SAF URIs and display names), the clipboard-ownership
     preferences, and the vault_recovery snapshots (copies of encrypted vault
     bytes). All of it is device-local state tied to SAF grants that do not
     survive a transfer, so it is excluded rather than restored in a broken
     state. The vault file itself lives in a user-chosen SAF location, outside
     app storage, and is unaffected by these rules.

     Every domain is excluded explicitly (exclude wins over include and over
     the default "everything"), rather than relying on allowBackup="false"
     alone, because on Android 12+ some OEM device-to-device transfer
     implementations do not honour allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
